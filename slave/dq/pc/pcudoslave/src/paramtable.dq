
use ./simple_partable   reexport

// The *ModuleInit() in the implementation section changes the parameter table


implementation

use ./device
use ./simple_scope

const     PTENTRY_EMPTY : SUdoParamDef = { 0, nil, nil }

constexpr PTENTRY_CONST(n : int)   : SUdoParamDef = { PAR_INT32_CONST, pointer(n), nil }
constexpr PTENTRY_CONST8(n : byte) : SUdoParamDef = { PAR_UINT8_CONST, pointer(uint(n)), nil }

constexpr PAR_TABLE(astart : uint16, atab : []SUdoParamDef) : SUdoParamRangeDef =
    { astart, astart + atab.length - 1, %atab[0], nil }


/*****************************************************************************************************************
                                             PARAMETER TABLES
******************************************************************************************************************/
// range tables must come before the main

