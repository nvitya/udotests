/* +08*/ { PAR_INT32_RW,  %g_device.par_dummy_i32,      nil },
/* +09*/ { PAR_INT16_RW,  %g_device.par_dummy_i16,      nil }

///* +0A*/{ PTENTRY_SPECIALFUNC(0, &g_device, PWdParMethod(&TDevice::pfn_big_data)) }, //
]

