/*****************************************************************************************************************
                                       THE MAIN RANGE TABLE
******************************************************************************************************************/
//extern const TParamRangeDef  param_range_table[]; // this must be here to keep the table under

const param_range_table : [?] SUdoParamRangeDef =
[
	{0x1000, 0x1018, nil, g_device.prfn_CanObj_1008_1018 }, // some RO device identifiactions

	PAR_TABLE(0x2000, pt_2000_app),   // main application parameters
	PAR_TABLE(0x5000, pt_5000_scope), // scope parameters

	// close the list with all zeroes
	{ ? }
]

/*****************************************************************************************************************
******************************************************************************************************************/

func *ModuleInit():
    g_udoparams.SetRangeTable(%param_range_table[0])
endfunc