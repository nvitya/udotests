use udo/udoslave
use ./simple_partable

const DEVICE_NAME : rostr = "UDOIP PC Test"

object ODevice:

    irq_period_ns     : uint32 = 4000000
    idlecounter       : uint32 = 0
    irq_cycle_counter : uint32 = 0

    func_i32_1  : int32  = 321
    func_i32_2  : int32  = 322
    func_i16_1  : int16  = 161
    func_i16_2  : int16  = 162
    func_fl_1   : float32  = 0xF01
    func_fl_2   : float32  = 0xF02

    par_dummy_i32   : int32  = 0xABCD1234
    par_dummy_i16   : int16  = 0x55AA

	seed_sin : [4]float32 = [0.0,  0.0,   0.0,  0.0]
	seed_inc : [4]float32 = [0.01, 0.011, 0.02, 0.05]

    udo_str_buf : embstr(64)

    func Init() ..
    func Run() ..

    func IrqTask() ..

public
    func pfn_Ignore(rq : ref SUdoRequest, pdef : ^SUdoParamDef, varptr : pointer) -> bool ..

    func prfn_CanObj_1008_1018(rq : ref SUdoRequest, prdef : ^SUdoParamRangeDef) -> bool ..

endobject

var g_device <- ODevice()


implementation


use ./version
use math

func ODevice.Init():

endfunc

func ODevice.Run():
    ++idlecounter
endfunc

func ODevice.IrqTask():
    use *
    ++irq_cycle_counter

	// generate some functions for scoping

	for n : int = 0 count 4:
		seed_sin[n] += seed_inc[n];
		while seed_sin[n] > 2 * M_PI32:
			seed_sin[n] -= 2 * M_PI32;
		endwhile
	endfor

	func_i32_1 = Trunc(100000.0 * Sin32(seed_sin[0]))
	func_i32_2 = Trunc(50000.0 + 50000.0 * Sin32(seed_sin[1]) + 10000.0 * Sin32(seed_sin[3]))
	func_i16_1 = Trunc(10000 * Sin32(seed_sin[0]) + 5000 * Sin32(seed_sin[1]) + 2500 * Sin32(seed_sin[2]) + 1000 * Sin32(seed_sin[3]))
	func_i16_2 = Trunc(1000 * Sin32(seed_sin[0]) + 2000 * Sin32(seed_sin[1]) + 3000 * Sin32(seed_sin[2]) + 4000 * Sin32(seed_sin[3]))
	func_fl_1 = 1000 / (1 + irq_cycle_counter)
	func_fl_2 = (irq_cycle_counter / 1000.0) * Sin32(seed_sin[2] + seed_sin[0])

	//g_scope.RunIrqTask();
endfunc

func ODevice.prfn_CanObj_1008_1018(rq : ref SUdoRequest, prdef : ^SUdoParamRangeDef) -> bool:
    use *
    if rq.iswrite:
        return rq.Error(UDOERR_READ_ONLY)
    endif

    var len : int

    if   0x1008 == rq.index:  // Device name
        return rq.RoStr(DEVICE_NAME)

    elif 0x1009 == rq.index:  // Hardware version as string
        udo_str_buf.Clear()
        udo_str_buf.Add('???')
        return rq.RoStr(udo_str_buf)

    elif 0x100A == rq.index:  // Software version as string
        udo_str_buf.Clear()
        udo_str_buf.AddFmt('APP: {}', [VERSION_INTEGER])
        return rq.RoStr(udo_str_buf)

    elif 0x1018 == rq.index:  // identity
        if   0 == rq.offset:
            return rq.RoInt(4, 1)  // number of entries here
        elif 1 == rq.offset:
            return rq.RoInt(0x00000abc, 4)
        elif 2 == rq.offset:
            return rq.RoInt(0x000000A1, 4)  // product code
        elif 3 == rq.offset:
            return rq.RoInt(VERSION_INTEGER, 4)  // revision
        elif 4 == rq.offset:
            return rq.RoInt(0x00000000, 4)  // serial number 32 bit
        endif
        return rq.Error(UDOERR_WRONG_OFFSET)
    endif

    return rq.Error(UDOERR_INDEX)
endfunc

func ODevice.pfn_Ignore(rq : ref SUdoRequest, pdef : ^SUdoParamDef, varptr : pointer) -> bool:
    if not rq.iswrite:
        return rq.RoInt(0, 4)
    endif
    // ignore writes !
    return true
endfunc
