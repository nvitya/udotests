use print
use udo/udoip_slave_os

object OUdoSlaveApp(OUdoSlave):
public
    testvar : int32

    func ParamReadWrite(udorq : ref SUdoRequest) -> bool [[override]] ..
endobject

func OUdoSlaveApp.ParamReadWrite(udorq : ref SUdoRequest) -> bool [[override]]:
    if 0x2000 == udorq.index:
        testvar += 1
        result = udorq.RwData(%testvar, SizeOf(testvar))
    else:
        result = inherited ParamReadWrite(udorq)
    endif
endfunc

//-----------------------------------------------------------------------------

var slaveapp  <- OUdoSlaveApp()
var udpserver <- OUdpServerUdoIpSlave(slaveapp, 1221)

func *Main():
    PrintLn('UDO-IP Slave (DQ)')

    udpserver.InitListener()

    PrintLn('Starting main cycle...')
    while true:
      udpserver.WaitForEvents(1000)
    endwhile

    PrintLn('Test finished.')
endfunc
